  }
  return false;
}
void handleSave() {
  String s = web.arg("s"), p = web.arg("p"), loc = web.arg("loc");
  s.trim(); loc.trim();
  int b = web.arg("b").toInt();
  bool badWifi = s.length() > 32 || (s.length() && p.length() > 0 && (p.length() < 8 || p.length() > 63));
  bool noWifi = !s.length() && !prefs.isKey("ssid") && !otherWifiSaved();
  float la, lo;
  bool isCoords = loc.length() && !loc.startsWith("http") && parseLocation(loc, la, lo);
  bool isLink = loc.startsWith("https://") && (loc.indexOf("google.") > 0 || loc.indexOf("goo.gl") > 0);
  if (badWifi || noWifi || b < 1 || b > 9 || (loc.length() && !isCoords && !isLink)) {
    web.send(400, "text/html; charset=utf-8", String(FPSTR(PAGE_HEAD)) +
             "<h1>Revisa los datos</h1><p>Hace falta tu Wi-Fi (clave de 8 a 63 caracteres). La ubicación puede ir vacía, "
             "como 40.42, -3.70 o como enlace de Google Maps.</p><a href=/>Volver</a>");
    return;
  }
  if (s.length()) { prefs.putString("ssid", s); prefs.putString("pass", p); }
  prefs.putInt("bortle", b);
  if (isCoords) { prefs.putFloat("lat", la); prefs.putFloat("lon", lo); prefs.putString("src", "manual"); prefs.remove("link"); }
  else if (isLink) prefs.putString("link", loc);
  web.send(200, "text/html; charset=utf-8", String(FPSTR(PAGE_HEAD)) + "<h1>Guardado</h1><p>La placa se reinicia.</p>");
  Serial.println("MSR_ASTRO_SETTINGS_SAVED");
  delay(1200);
  ESP.restart();
}
static int qrX = 0, qrY = 0;
void drawQr(esp_qrcode_handle_t q) {
  int size = esp_qrcode_get_size(q), sc = max(1, 150 / (size + 4));
  gfx->fillRect(qrX, qrY, (size + 4) * sc, (size + 4) * sc, 0xFFFF);
  for (int y = 0; y < size; y++)
    for (int x = 0; x < size; x++)
      if (esp_qrcode_get_module(q, x, y)) gfx->fillRect(qrX + (x + 2) * sc, qrY + (y + 2) * sc, sc, sc, 0x0000);
}
void startPortal() {
  portalMode = true;
  shooting = false;
  redMode = false;
  analogWrite(PIN_BL, 255);
  WiFi.disconnect(true);
  WiFi.mode(WIFI_AP_STA);
  int n = WiFi.scanNetworks();
  scannedOptions = "";
  for (int i = 0; i < n && i < 15; i++) scannedOptions += "<option value=\"" + htmlEscape(WiFi.SSID(i)) + "\">";
  WiFi.scanDelete();
  char pass[9];
  snprintf(pass, sizeof(pass), "%08lu", (unsigned long)(esp_random() % 100000000UL));
  WiFi.softAP("AstroCYD-MS", pass);
  dns.start(53, "*", WiFi.softAPIP());
  web.on("/", HTTP_GET, handleRoot);
  web.on("/save", HTTP_POST, handleSave);
  web.onNotFound([] { web.sendHeader("Location", "http://192.168.4.1/"); web.send(302, "text/plain", ""); });
  web.begin();
  gfx->fillScreen(BG);
  gfx->fillRect(0, 0, W, 26, HEAD);
  put(10, 9, "ASTROCYD · AJUSTES DESDE EL MÓVIL", ACC, 1, HEAD);
  String qr = "WIFI:T:WPA;S:AstroCYD-MS;P:" + String(pass) + ";;";
  qrX = 8; qrY = 40;
  esp_qrcode_config_t cfg = ESP_QRCODE_CONFIG_DEFAULT();
  cfg.display_func = drawQr;
  cfg.max_qrcode_version = 6;
  esp_qrcode_generate(&cfg, qr.c_str());
  put(170, 44, "1. Escanea el QR", TXT);
  put(170, 58, "   con el móvil", TXT);
  put(170, 80, "2. Se abre la web;", TXT);
  put(170, 94, "   si no: 192.168.4.1", DIM);
  put(170, 116, "3. Wi-Fi, ubicación", TXT);
  put(170, 130, "   y tu cielo", TXT);
  put(170, 156, "Red: AstroCYD-MS", ACC);
  put(170, 170, "Clave:", ACC);
  put(212, 166, pass, AMB, 2);
  setLed(false, false, true);
  Serial.println("MSR_ASTRO_PORTAL ap=AstroCYD-MS");
}
bool connectWifi() {
  String s = prefs.getString("ssid", ""), p = prefs.getString("pass", "");
  for (const char* ns : {"radaravion", "kilovatio"}) {
    if (s.length()) break;
    Preferences k;
    if (k.begin(ns, true)) { s = k.getString("ssid", ""); p = k.getString("pass", ""); k.end(); }
  }
  if (!s.length()) return false;
  WiFi.mode(WIFI_STA);
  WiFi.setHostname("astrocyd-ms");
  WiFi.begin(s.c_str(), p.c_str());
  gfx->fillScreen(BG);
  putCenter(160, 96, "ASTROCYD", ACC, 3);
  putCenter(160, 132, "Conectando a la Wi-Fi...", TXT);
  for (int i = 0; i < 40 && WiFi.status() != WL_CONNECTED; i++) {
    gfx->fillCircle(130 + (i % 5) * 15, 160, 4, ACC);
    if (i % 5 == 4) gfx->fillRect(120, 154, 80, 12, BG);
    delay(500);
  }
  return WiFi.status() == WL_CONNECTED;
}

// ---------- Gestos ----------
bool touching = false, longFired = false;
int downX = 0, downY = 0;
uint32_t downAt = 0, upAt = 0;
void onTap(int x, int y) {
  if (y >= 220) {
    int t = constrain(x / 53, 0, 5);
    if (t != tab) {
      tab = t;
      if (tab == 5) startBle();
      if (tab == 4) previewBortle = 0;
      drawAll();
    }
    return;
  }
  if (y < 18) {
    if (x >= 266) { redMode = !redMode; analogWrite(PIN_BL, redMode ? 50 : 255); drawAll(); }
    else if (shiftH) { shiftH = 0; drawAll(); }
    return;
  }
  if (tab == 0) tapSky(x, y);
  else if (tab == 4 && y >= 200) {
    int b = previewBortle ? previewBortle : bortle;
    if (x < 135) b = max(1, b - 1); else if (x > 185) b = min(9, b + 1);
    previewBortle = b;
    drawLightTab();
  } else if (tab == 5) tapPhoto(x, y);
}
void handleTouch() {
  int rx, ry;
  uint32_t t = millis();
  if (sampleRaw(rx, ry)) {
    int x, y;
    toScreen(rx, ry, x, y);
    if (!touching) { touching = true; longFired = false; downX = x; downY = y; downAt = t; }
    upAt = t;
    if (!longFired && t - downAt > 3000) { longFired = true; startPortal(); }
    return;
  }
  if (touching && t - upAt > 60) {
    touching = false;
    if (!longFired && !portalMode) onTap(downX, downY);
  }
}

// ---------- Autoprueba con ejemplos del libro de Meeus ----------
bool near(double a, double b, double tol) { double d = fabs(a - b); if (d > 180) d = 360 - d; return d <= tol; }
bool selfTest() {
  bool ok = true;
  auto chk = [&](const char* what, double got, double want, double tol) {
    bool g = near(got, want, tol);
    Serial.printf("MSR_ASTRO_TEST %s got=%.4f want=%.4f %s\n", what, got, want, g ? "OK" : "FAIL");
    ok &= g;
  };
  astro::Eq s = astro::sun(astro::dayNumber(718934400));  // 13 oct 1992 (ej. 25.a)
  chk("sol_ra", s.ra, 198.38083, 0.05); chk("sol_dec", s.dec, -7.78507, 0.05);
  astro::MoonState m = astro::moon(astro::dayNumber(703036800));  // 12 abr 1992 (ej. 47.a)
  chk("luna_ra", m.eq.ra, 134.68847, 0.15); chk("luna_dec", m.eq.dec, 13.76837, 0.15);
  chk("luna_km", m.eq.dist * 6378.14, 368409.7, 1500);
  astro::Planet v = astro::planet(1, astro::dayNumber(724809600));  // Venus 20 dic 1992 (ej. 33.a)
  chk("venus_ra", v.eq.ra, 316.17273, 0.05); chk("venus_dec", v.eq.dec, -18.88801, 0.05);
  chk("gmst", astro::gmst(astro::dayNumber(545011200)), 197.693195, 0.05);  // 10 abr 1987 (ej. 12.a)
  double lst = astro::rev(astro::gmst(astro::dayNumber(545080860)) - 77.06556);  // Washington (ej. 13.b)
  astro::Hor h = astro::toHorizon(347.3193375, -6.719892, lst, 38.92139);
  chk("alt", h.alt, 15.1249, 0.1); chk("az", h.az, 248.0337, 0.1);
  float la = 0, lo = 0;
  bool p1 = parseLocation("40.4168, -3.7038", la, lo) && near(la, 40.4168, 1e-3) && near(lo, -3.7038, 1e-3);
  bool p2 = parseLocation("https://www.google.com/maps/place/Sol/@40.4169473,-3.7035285,17z/data=!3m1!4b1!4m6!3m5!1s0x0:0x0!8m2!3d40.4167754!4d-3.7037902", la, lo) && near(la, 40.41678, 1e-4);
  bool p3 = parseLocation("https://maps.google.com/?q=42.2167%2C-2.1", la, lo) && near(lo, -2.1, 1e-3);
  bool p4 = !parseLocation("https://maps.app.goo.gl/abcDEF123", la, lo);
  Serial.printf("MSR_ASTRO_TEST ubicacion %d%d%d%d %s\n", p1, p2, p3, p4, p1 && p2 && p3 && p4 ? "OK" : "FAIL");
  return ok && p1 && p2 && p3 && p4;
}

// ---------- Programa ----------
uint32_t lastSky = 0, lastClock = 0;
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.printf("MSR_ASTRO_BOOT selftest=%s stars=%d\n", selfTest() ? "OK" : "FAIL", STAR_COUNT);
  pinMode(LED_R, OUTPUT); pinMode(LED_G, OUTPUT); pinMode(LED_B, OUTPUT);
  setLed(false, false, false);
  pinMode(5, OUTPUT);
  digitalWrite(5, HIGH);  // microSD sin usar
  pinMode(PIN_BL, OUTPUT);
  analogWrite(PIN_BL, 255);
  lcdBus.begin(14, 12, 13, 15);
  lcd.begin(40000000);
  lcd.setRotation(1);
  lcd.cp437(true);
  touchBus.begin(25, 39, 32, 33);
  touch.begin(touchBus);
  touch.setRotation(1);

  prefs.begin("astrocyd", false);
  bortle = constrain(prefs.getInt("bortle", 5), 1, 9);
  if (prefs.isKey("lat")) {
    homeLat = prefs.getFloat("lat", homeLat); homeLon = prefs.getFloat("lon", homeLon);
    strlcpy(locSource, prefs.getString("src", "manual").c_str(), sizeof(locSource));
  } else {
    Preferences r;  // la ubicación de Radar Aviones MS, si la hay
    if (r.begin("radaravion", true)) {
      if (r.isKey("lat")) { homeLat = r.getFloat("lat", homeLat); homeLon = r.getFloat("lon", homeLon); strlcpy(locSource, "radar", sizeof(locSource)); }
      r.end();
    }
  }
  if (!loadCalibration()) calibrate();
  if (!connectWifi()) { startPortal(); return; }
  Serial.printf("MSR_ASTRO_WIFI_OK rssi=%ld\n", WiFi.RSSI());
  configTime(0, 0, "pool.ntp.org", "time.google.com");
  gfx->fillScreen(BG);
  putCenter(160, 110, "Poniendo en hora...", TXT);
  for (int i = 0; i < 40 && time(nullptr) < 1700000000; i++) delay(250);
  timeOk = time(nullptr) > 1700000000;
  String link = prefs.getString("link", "");
  if (link.length()) resolveMapsLink(link);
  if (!strcmp(locSource, "defecto")) ipLocate();
  Serial.printf("MSR_ASTRO_LOCATION src=%s\n", locSource);  // nunca se imprimen las coordenadas
  if (fetchWeather()) weatherAt = millis();
  if (fetchKp()) kpAt = millis();
  drawAll();
  lastSky = lastClock = millis();
}

// Órdenes por USB para probar y sacar capturas sin tocar la pantalla:
// MSR_TAB n · MSR_TAP x y · MSR_RED · MSR_SHIFT h · MSR_SHOT (manda la pantalla en RGB565).
// Lienzo de una franja de la pantalla: una captura entera (150 KB) no cabe en la RAM libre.
class Strip : public Adafruit_GFX {
 public:
  uint16_t buf[W * 48];
  int y0 = 0;
  Strip() : Adafruit_GFX(W, H) {}
  void drawPixel(int16_t x, int16_t y, uint16_t c) override {
    y -= y0;
    if (x >= 0 && x < W && y >= 0 && y < 48) buf[y * W + x] = c;
  }
};
void sendScreenshot() {
  Strip* st = new (std::nothrow) Strip();
  if (!st) { Serial.printf("MSR_SHOT_ERROR heap=%u\n", (unsigned)ESP.getFreeHeap()); return; }
  st->cp437(true);
  Serial.printf("MSR_SHOT_BEGIN %d %d\n", W, H);
  for (st->y0 = 0; st->y0 < H; st->y0 += 48) {
    memset(st->buf, 0, sizeof(st->buf));
    gfx = st;
    drawAll();
    gfx = &lcd;
    Serial.write((const uint8_t*)st->buf, sizeof(st->buf));  // little-endian, fila a fila
  }
  Serial.println();
  Serial.println("MSR_SHOT_END");
  delete st;
}
void pollSerial() {
  static char buf[40];
  static uint8_t len = 0;
  while (Serial.available()) {
    char c = Serial.read();
    if (c != '\n' && c != '\r') { if (len < sizeof(buf) - 1) buf[len++] = c; continue; }
    buf[len] = 0;
    len = 0;
    int a, b;
    if (sscanf(buf, "MSR_TAB %d", &a) == 1) { tab = constrain(a, 0, 5); if (tab == 5) startBle(); drawAll(); }
    else if (sscanf(buf, "MSR_TAP %d %d", &a, &b) == 2) onTap(a, b);
    else if (!strcmp(buf, "MSR_RED")) onTap(300, 8);
    else if (sscanf(buf, "MSR_SHIFT %d", &a) == 1) { shiftH = constrain(a, -12, 12); drawAll(); }
    else if (!strcmp(buf, "MSR_SHOT")) sendScreenshot();
    else continue;
    Serial.printf("MSR_CMD_OK %s\n", buf);
  }
}

void loop() {
  if (portalMode) { dns.processNextRequest(); web.handleClient(); delay(2); return; }
  pollSerial();
  handleTouch();
  uint32_t ms = millis();
  if (shooting && ms >= nextShotAt) {
    if (shutter()) { shots++; Serial.printf("MSR_ASTRO_SHOT n=%d\n", shots); }
    nextShotAt = ms + ivSec * 1000UL;
    if (ivCount && shots >= ivCount) { shooting = false; Serial.println("MSR_ASTRO_INTERVAL DONE"); }
    if (tab == 5) drawPhotoTab();
  }
  if (bleDirty) { bleDirty = false; if (tab == 5) drawPhotoTab(); }
  if (ms - weatherAt > 30 * 60000UL && WiFi.status() == WL_CONNECTED && !shooting) {
    weatherAt = ms;  // un fallo espera al siguiente ciclo, no reintenta en bucle
    fetchWeather();
    if (fetchKp()) kpAt = millis();
    if (tab == 2 || tab == 3) drawTab();
  }
  if (!timeOk && time(nullptr) > 1700000000) { timeOk = true; drawAll(); }
  if (ms - lastClock > 10000) {
    lastClock = ms;
    drawHeader();
    float kp = kpNow();
    bool alert = kp >= 0 && kp >= astro::kpNeeded(fabsf(astro::geomagLat(homeLat, homeLon)));
    setLed(alert, false, false);
    if (tab == 5 && shooting) drawPhotoTab();
  }
  if (tab == 0 && ms - lastSky > 30000 && !touching) { lastSky = ms; drawSky(); drawSkyPanel(); }
  delay(2);
}
