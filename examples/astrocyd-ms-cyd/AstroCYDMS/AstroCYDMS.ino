// ---------- Proyección del cielo ----------
// Equidistante azimutal: cenit en el centro, horizonte en el borde, norte arriba y este a la
// izquierda (como al mirar hacia arriba). Devuelve false si está bajo el horizonte.
bool project(const SkyView& v, float raDeg, float decDeg, int& x, int& y, float* altOut = nullptr, float* azOut = nullptr) {
  float ha = (v.lst - raDeg) * (float)DEG_TO_RAD, dec = decDeg * (float)DEG_TO_RAD;
  float cd = cosf(dec), sd = sinf(dec), xx = cosf(ha) * cd, yy = sinf(ha) * cd;
  float zh = xx * v.clat + sd * v.slat;
  float alt = asinf(fmaxf(-1, fminf(1, zh))) * RAD_TO_DEG;
  float xh = xx * v.slat - sd * v.clat;
  float az = atan2f(yy, xh) * RAD_TO_DEG + 180;
  if (altOut) *altOut = alt;
  if (azOut) *azOut = az;
  if (alt < 0) return false;
  float rr = (90 - alt) / 90 * v.r, a = az * (float)DEG_TO_RAD;
  x = v.cx - lroundf(rr * sinf(a));
  y = v.cy - lroundf(rr * cosf(a));
  return true;
}
SkyView makeView(int cxv, int cyv, int r, time_t utc) {
  return {cxv, cyv, r, (float)lstAt(utc), sinf(homeLat * DEG_TO_RAD), cosf(homeLat * DEG_TO_RAD)};
}
inline float starRa(const Star& s) { return s.ra * (360.0f / 65536); }
inline float starDec(const Star& s) { return s.dec / 100.0f; }
uint16_t starColor(int bv10, float bright) {
  int r, g, b;  // azul-blanco a naranja según el índice de color B-V
  if (bv10 < 0) { r = 170; g = 200; b = 255; } else if (bv10 < 5) { r = 235; g = 240; b = 255; }
  else if (bv10 < 10) { r = 255; g = 235; b = 190; } else { r = 255; g = 190; b = 140; }
  r *= bright; g *= bright; b *= bright;
  return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
}
// Dibuja las estrellas hasta `limMag`; guarda su posición si sx/sy no son nulos. Devuelve cuántas.
int drawStars(const SkyView& v, float limMag, int16_t* sx, int16_t* sy, bool big) {
  int n = 0;
  for (int i = 0; i < STAR_COUNT; i++) {
    const Star& s = STARS[i];
    float mag = s.mag10 / 10.0f;
    if (mag > limMag) { if (sx) sx[i] = -1; continue; }
    int x, y;
    if (!project(v, starRa(s), starDec(s), x, y)) { if (sx) sx[i] = -1; continue; }
    if (sx) { sx[i] = x; sy[i] = y; }
    n++;
    float bright = mag < 3 ? 1.0f : fmaxf(0.35f, 1.0f - (mag - 3) * 0.22f);
    uint16_t c = C(starColor(s.bv10, bright));
    if (big && mag < 0.5f) gfx->fillCircle(x, y, 2, c);
    else if (big && mag < 1.5f) gfx->fillCircle(x, y, 1, c);
    else if (mag < 2.5f) gfx->fillRect(x, y, 2, 2, c);
    else gfx->drawPixel(x, y, c);
  }
  return n;
}

// ---------- Pantalla CIELO ----------
constexpr int SKY_CX = 106, SKY_CY = 119, SKY_R = 98;
int16_t starX[STAR_COUNT], starY[STAR_COUNT];
Kind selKind = K_NONE;
int selIdx = -1;
int planetX[5], planetY[5], moonX = -99, moonY = -99, sunX = -99, sunY = -99;
int visibleStars = 0;

void drawMoonDisc(int x0, int y0, int r, double age, bool south, uint16_t lit, uint16_t dark) {
  for (int dy = -r; dy <= r; dy++) {
    float w = sqrtf((float)(r * r - dy * dy));
    float c = cosf(age * DEG_TO_RAD);
    float a, b;  // tramo iluminado en x (hemisferio norte: crece por la derecha)
    if (age < 180) { a = w * c; b = w; } else { a = -w; b = -w * c; }
    if (south) { float t = -b; b = -a; a = t; }
    gfx->drawFastHLine(x0 - (int)w, y0 + dy, 2 * (int)w + 1, C(dark));
    if (b > a) gfx->drawFastHLine(x0 + (int)lroundf(a), y0 + dy, (int)lroundf(b - a) + 1, C(lit));
  }
}

void drawSky() {
  time_t t = viewUtc();
  double d = astro::dayNumber(t);
  SkyView v = makeView(SKY_CX, SKY_CY, SKY_R, t);
  double sAlt = sunAlt(t);
  uint16_t skyBg = sAlt > -0.8 ? 0x2A6F : sAlt > -12 ? 0x10EC : SKY;
  gfx->fillRect(0, 19, 211, 201, C(BG));
  gfx->fillCircle(SKY_CX, SKY_CY, SKY_R, C(skyBg));
  gfx->drawCircle(SKY_CX, SKY_CY, SKY_R, C(SKYLINE));
  gfx->drawCircle(SKY_CX, SKY_CY, SKY_R * 2 / 3, C(0x10A8));  // 30° de altura
  // Constelaciones: trazos cuyos dos extremos están sobre el horizonte.
  for (int p = 0; p < CPOLY_COUNT; p++) {
    const CPoly& pl = CPOLYS[p];
    int px = 0, py = 0;
    bool prevUp = false;
    for (int k = 0; k < pl.count; k++) {
      const CPoint& q = CPOINTS[pl.first + k];
      int x, y;
      bool up = project(v, q.ra * (360.0f / 65536), q.dec / 100.0f, x, y);
      if (up && prevUp) gfx->drawLine(px, py, x, y, C(CLINE));
      px = x; py = y; prevUp = up;
    }
  }
  float lim = astro::limitingMag(bortle);
  visibleStars = drawStars(v, lim, starX, starY, true);
  for (int c = 0; c < CON_COUNT; c++) {
    if (CLABELS[c].rank > 1) continue;
    int x, y;
    float alt;
    if (project(v, CLABELS[c].ra * (360.0f / 65536), CLABELS[c].dec / 100.0f, x, y, &alt) && alt > 12) {
      int w = textWidth(CON_NAMES[c], 1);
      if (x - w / 2 > 2 && x + w / 2 < 210) put(x - w / 2, y + 6, CON_NAMES[c], 0x6B7E);
    }
  }
  // Planetas, Luna y Sol
  for (int p = 0; p < 5; p++) {
    astro::Planet pl = astro::planet(p, d);
    planetX[p] = -99;
    int x, y;
    if (project(v, pl.eq.ra, pl.eq.dec, x, y)) {
      planetX[p] = x; planetY[p] = y;
      gfx->fillCircle(x, y, 3, C(PLANET_COL[p]));
      int tw = textWidth(PLANET_NAMES[p], 1);
      put(x + 5 + tw < 210 ? x + 5 : x - 5 - tw, y - 3, PLANET_NAMES[p], PLANET_COL[p]);  // sin pisar el panel
    }
  }
  astro::MoonState m = astro::moon(d);
  astro::Hor mh = astro::moonHorizon(d, v.lst, homeLat);
  moonX = -99;
  if (mh.alt > 0) {
    float rr = (90 - mh.alt) / 90 * SKY_R, a = mh.az * DEG_TO_RAD;
    moonX = SKY_CX - lroundf(rr * sinf(a)); moonY = SKY_CY - lroundf(rr * cosf(a));
    double illum, age;
    astro::moonPhase(d, illum, age);
    drawMoonDisc(moonX, moonY, 6, age, homeLat < 0, 0xEF3A, 0x2124);
  }
  astro::Eq se = astro::sun(d);
  sunX = -99;
  int x, y;
  if (project(v, se.ra, se.dec, x, y)) { sunX = x; sunY = y; gfx->fillCircle(x, y, 7, C(0xFE60)); }
  (void)m;
  // Puntos cardinales
  put(SKY_CX - 2, SKY_CY - SKY_R - 0, "N", ACC, 1, skyBg);
  put(SKY_CX - SKY_R + 2, SKY_CY - 3, "E", ACC, 1, skyBg);
  put(SKY_CX + SKY_R - 7, SKY_CY - 3, "O", ACC, 1, skyBg);
  put(SKY_CX - 2, SKY_CY + SKY_R - 8, "S", ACC, 1, skyBg);
  if (sAlt > -0.8) put(4, 209, "De día: el Sol tapa las estrellas", AMB);
  // Resalte del objeto elegido
  int hx = -99, hy = 0;
  if (selKind == K_STAR && selIdx >= 0 && starX[selIdx] >= 0) { hx = starX[selIdx]; hy = starY[selIdx]; }
  else if (selKind == K_PLANET && planetX[selIdx] > -99) { hx = planetX[selIdx]; hy = planetY[selIdx]; }
  else if (selKind == K_MOON && moonX > -99) { hx = moonX; hy = moonY; }
  else if (selKind == K_SUN && sunX > -99) { hx = sunX; hy = sunY; }
  if (hx > -99) gfx->drawCircle(hx, hy, 9, C(AMB));
}

void drawSkyPanel() {
  const int x0 = 213, w = 105;
  gfx->fillRect(x0, 19, W - x0, 201, C(BG));
  gfx->drawRoundRect(x0, 22, w, 150, 5, C(SKYLINE));
  time_t t = viewUtc();
  double d = astro::dayNumber(t), lst = lstAt(t);
  char line[40];
  const char* name = nullptr;
  char sub[28] = "";
  double alt = 0, az = 0, mag = 99;
  bool have = true;
  if (selKind == K_STAR && selIdx >= 0) {
    const Star& s = STARS[selIdx];
    astro::Hor h = astro::toHorizon(starRa(s), starDec(s), lst, homeLat);
    alt = h.alt; az = h.az; mag = s.mag10 / 10.0;
    name = s.name != 255 ? STAR_NAMES[s.name] : "Estrella";
    if (s.con != 255) snprintf(sub, sizeof(sub), "en %s", CON_NAMES[s.con]); else strlcpy(sub, "estrella", sizeof(sub));
  } else if (selKind == K_PLANET) {
    astro::Planet p = astro::planet(selIdx, d);
    astro::Hor h = astro::toHorizon(p.eq.ra, p.eq.dec, lst, homeLat);
    alt = h.alt; az = h.az; mag = p.mag; name = PLANET_NAMES[selIdx]; strlcpy(sub, "planeta", sizeof(sub));
  } else if (selKind == K_MOON) {
    astro::Hor h = astro::moonHorizon(d, lst, homeLat);
    double illum, age;
    astro::moonPhase(d, illum, age);
    alt = h.alt; az = h.az; name = "Luna";
    snprintf(sub, sizeof(sub), "iluminada %d%%", (int)lround(illum * 100));
  } else if (selKind == K_SUN) {
    astro::Eq s = astro::sun(d);
    astro::Hor h = astro::toHorizon(s.ra, s.dec, lst, homeLat);
    alt = h.alt; az = h.az; name = "Sol"; strlcpy(sub, "no lo mires", sizeof(sub));
  } else have = false;
  if (!have) {
    put(x0 + 7, 34, "Toca una", DIM); put(x0 + 7, 46, "estrella o un", DIM); put(x0 + 7, 58, "planeta", DIM);
  } else {
    put(x0 + 5, 28, name, AMB, textWidth(name, 2) <= w - 8 ? 2 : 1);
    put(x0 + 5, 48, sub, DIM);
    put(x0 + 5, 64, "ALTURA", DIM);
    snprintf(line, sizeof(line), "%d\xC2\xB0", (int)lround(alt));
    put(x0 + 5, 74, line, TXT, 2);
    put(x0 + 5, 96, "MIRA HACIA", DIM);
    put(x0 + 5, 106, dirName(az), TXT, textWidth(dirName(az), 2) <= w - 8 ? 2 : 1);
    if (mag < 50) {
      put(x0 + 5, 128, "BRILLO", DIM);
      snprintf(line, sizeof(line), "magnitud %.1f", mag);
      put(x0 + 5, 138, line, TXT);
    }
    if (selKind == K_SUN) put(x0 + 5, 154, "Peligro: vista", RED);
  }
  btn(x0, 176, 33, 18, "-1h", ACC);
  btn(x0 + 36, 176, 33, 18, "ya", shiftH ? AMB : DIM);
  btn(x0 + 72, 176, 33, 18, "+1h", ACC);
  snprintf(line, sizeof(line), "%d estrellas", visibleStars);
  put(x0 + 2, 199, line, GRN);
  snprintf(line, sizeof(line), "Bortle %d, mag %.1f", bortle, astro::limitingMag(bortle));
  put(x0 + 2, 209, line, DIM);
}

void tapSky(int x, int y) {
  if (x >= 213 && y >= 176 && y < 194) {
    if (x < 246) shiftH = max(-12, shiftH - 1); else if (x < 282) shiftH = 0; else shiftH = min(12, shiftH + 1);
    drawAll();
    return;
  }
  if (x >= 210) return;
  int best = -1;
  Kind bk = K_NONE;
  long bd = 14 * 14;
  auto consider = [&](Kind k, int idx, int ox, int oy, long bias) {
    if (ox <= -99) return;
    long dd = (long)(ox - x) * (ox - x) + (long)(oy - y) * (oy - y);
    if (dd <= 14 * 14 && dd + bias < bd) { bd = dd + bias; best = idx; bk = k; }
  };
  for (int p = 0; p < 5; p++) consider(K_PLANET, p, planetX[p], planetY[p], -60);
  consider(K_MOON, 0, moonX, moonY, -80);
  consider(K_SUN, 0, sunX, sunY, -80);
  for (int i = 0; i < STAR_COUNT; i++)
    if (starX[i] >= 0) consider(K_STAR, i, starX[i], starY[i], (long)(STARS[i].mag10 * 3));  // prefiere las brillantes
  if (best >= 0) { selKind = bk; selIdx = best; }
  drawSky();
  drawSkyPanel();
}

// ---------- Pantalla LUNA ----------
const char* phaseName(double age) {
  if (age < 10 || age > 350) return "Luna nueva";
  if (age < 80) return "Creciente";
  if (age < 100) return "Cuarto creciente";
  if (age < 170) return "Gibosa creciente";
  if (age < 190) return "Luna llena";
  if (age < 260) return "Gibosa menguante";
  if (age < 280) return "Cuarto menguante";
  return "Menguante";
}
time_t nextPhase(time_t from, double target) {  // primer instante en que la edad pasa por target
  double prev, illum;
  astro::moonPhase(astro::dayNumber(from), illum, prev);
  for (time_t t = from + 3600; t < from + 32 * 86400LL; t += 3600) {
    double age;
    astro::moonPhase(astro::dayNumber(t), illum, age);
    double a = astro::rev(prev - target + 180), b = astro::rev(age - target + 180);
    if (a < 180 && b >= 180) return t;
    prev = age;
  }
  return 0;
}
