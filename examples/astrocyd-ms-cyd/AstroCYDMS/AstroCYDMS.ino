// ---------- Pantalla NOCHE ----------
NightHour nightH[13];
float nightQuality(time_t t, NightHour& h) {
  double d = astro::dayNumber(t), lst = lstAt(t);
  double sa = sunAlt(t), illum, age;
  astro::moonPhase(d, illum, age);
  double ma = astro::moonHorizon(d, lst, homeLat).alt;
  h.t = t;
  h.cloud = cloudAt(t);
  h.dark = sa < -18;
  h.moonUp = ma > 0;
  h.gcUp = astro::toHorizon(266.405, -28.936, lst, homeLat).alt > 10 && h.dark;
  float darkF = sa < -18 ? 1 : sa < -12 ? 0.5f : 0;
  float moonF = ma > 0 ? illum * (0.5f + 0.5f * fminf(1, ma / 30)) : 0;
  float cl = h.cloud < 0 ? 0.5f : h.cloud / 100.0f;
  h.q = (1 - cl) * (1 - 0.8f * moonF) * darkF;
  return h.q;
}
void drawNightTab() {
  gfx->fillRect(0, 19, W, 201, C(BG));
  time_t now = nowUtc(), local = now + utcOffset;
  long hourLocal = local % 86400 / 3600;
  time_t day0 = local / 86400 * 86400 - (hourLocal < 7 ? 86400 : 0);  // medianoche local del día de la noche
  time_t start = day0 + 18 * 3600 - utcOffset;
  for (int i = 0; i < 13; i++) nightQuality(start + i * 3600, nightH[i]);
  float bortleF = 1 - (bortle - 1) * 0.06f;
  int bestI = 0;
  float best = -1;
  for (int i = 0; i + 1 < 13; i++) {
    if (nightH[i + 1].t < now - 3600) continue;  // ventanas ya pasadas
    float s = (nightH[i].q + nightH[i + 1].q) / 2;
    if (s > best) { best = s; bestI = i; }
  }
  int score = (int)lroundf(fmaxf(0, best) * bortleF * 10);
  char line[48], a[6], b[6];
  uint16_t sc = score >= 7 ? GRN : score >= 4 ? AMB : RED;
  snprintf(line, sizeof(line), "%d", score);
  put(12, 28, line, sc, 5);
  put(12 + textWidth(line, 5) + 2, 48, "/10", sc, 2);
  fmtHM(nightH[bestI].t, a);
  fmtHM(nightH[bestI].t + 7200, b);
  if (best > 0.05f) { snprintf(line, sizeof(line), "Sal a las %s", a); put(100, 26, line, TXT, 2); snprintf(line, sizeof(line), "mejor ventana %s-%s", a, b); put(100, 46, line, DIM); }
  else { put(100, 26, "Mala noche", RED, 2); put(100, 46, "nubes, Luna o luz", DIM); }
  time_t dusk = nextCross(sunAlt, start - 5 * 3600, -18, false, 12), dawn = nextCross(sunAlt, start, -18, true, 18);
  if (dusk && dawn) { fmtHM(dusk, a); fmtHM(dawn, b); snprintf(line, sizeof(line), "noche cerrada %s > %s", a, b); }
  else strlcpy(line, "sin noche astronómica", sizeof(line));
  put(100, 58, line, DIM);
  if (!cloudStart) put(100, 70, "sin datos de nubes todavía", AMB);
  // Barras: verde = calidad, gris = nubes, blanco tenue = Luna arriba
  for (int i = 0; i < 13; i++) {
    int x = 12 + i * 23, base = 164;
    const NightHour& h = nightH[i];
    int qh = (int)(h.q * 76), ch = h.cloud < 0 ? 0 : h.cloud * 76 / 100 / 2;
    gfx->drawFastHLine(x, base, 18, C(SKYLINE));
    if (qh) gfx->fillRect(x, base - qh, 18, qh, C(h.moonUp ? 0x9CD3 : GRN));
    if (ch) gfx->fillRect(x, base - qh - ch, 18, ch, C(0x3A2C));
    if (i == bestI || i == bestI + 1) gfx->drawRect(x - 1, base - 80, 20, 81, C(AMB));
  }
  put(10, 168, "18h", DIM); put(150, 168, "00h", DIM); put(288, 168, "06h", DIM);
  gfx->fillRect(12, 180, 7, 6, C(GRN)); put(22, 179, "despejado", DIM);
  gfx->fillRect(84, 180, 7, 6, C(0x3A2C)); put(94, 179, "nubes", DIM);
  gfx->fillRect(134, 180, 7, 6, C(0x9CD3)); put(144, 179, "Luna arriba", DIM);
  int g0 = -1, g1 = -1;
  for (int i = 0; i < 13; i++) if (nightH[i].gcUp) { if (g0 < 0) g0 = i; g1 = i; }
  put(12, 194, "VÍA LÁCTEA", DIM);
  if (g0 >= 0) { fmtHM(nightH[g0].t, a); fmtHM(nightH[g1].t + 3600, b); snprintf(line, sizeof(line), "centro visible %s-%s", a, b); put(90, 194, line, GRN); }
  else put(90, 194, "centro no visible esta noche", DIM);
  put(12, 206, "TU CIELO", DIM);
  snprintf(line, sizeof(line), "Bortle %d, %s", bortle, BORTLE_NAMES[bortle]);
  put(90, 206, line, AMB);
}

// ---------- Pantalla AURORA ----------
void drawAuroraTab() {
  gfx->fillRect(0, 19, W, 201, C(BG));
  float gm = astro::geomagLat(homeLat, homeLon), need = astro::kpNeeded(fabsf(gm));
  float kp = kpNow();
  char line[48];
  // Indicador semicircular de 0 a 9
  int gx = 80, gy = 132, gr = 58;
  for (int k = 0; k <= 90; k++) {
    float a = (180 - k * 2) * DEG_TO_RAD;
    uint16_t c = kp >= 0 && k <= kp * 10 ? (k >= need * 10 ? RED : k >= 50 ? AMB : GRN) : SKYLINE;
    for (int t = 0; t < 10; t++) gfx->drawPixel(gx + (gr - t) * cosf(a), gy - (gr - t) * sinf(a), C(c));
  }
  if (need <= 9) { float a = (180 - need * 20) * DEG_TO_RAD; gfx->drawLine(gx + (gr - 14) * cosf(a), gy - (gr - 14) * sinf(a), gx + (gr + 4) * cosf(a), gy - (gr + 4) * sinf(a), C(TXT)); }
  if (kp >= 0) snprintf(line, sizeof(line), "Kp %.1f", kp); else strlcpy(line, "Kp ?", sizeof(line));
  putCenter(gx, gy - 24, line, TXT, 2);
  putCenter(gx, gy - 4, kp >= 5 ? "tormenta solar" : "sin tormenta", kp >= 5 ? AMB : DIM);
  put(gx - gr, gy + 6, "0", DIM); put(gx + gr - 6, gy + 6, "9", DIM);
  put(160, 28, "EN TU ZONA HACE FALTA", DIM);
  if (need > 9) strlcpy(line, "Kp 9 y suerte", sizeof(line)); else snprintf(line, sizeof(line), "Kp %d o más", (int)ceilf(fmaxf(0, need)));
  put(160, 40, line, AMB, 2);
  float m3 = -1;
  for (int i = 0; i < 3; i++) m3 = fmaxf(m3, kpMaxDay(i));
  const char* prob = m3 < 0 ? "sin datos" : m3 >= need ? "POSIBLE" : m3 >= need - 1.5f ? "baja" : "muy baja";
  put(160, 66, "PROBABILIDAD 3 DÍAS", DIM);
  put(160, 78, prob, m3 >= need ? GRN : TXT, 2);
  put(160, 102, "MÁXIMO PREVISTO", DIM);
  for (int i = 0; i < 3; i++) {
    float v = kpMaxDay(i);
    int x = 160 + i * 50;
    uint16_t c = v >= need ? RED : v >= 5 ? AMB : GRN;
    gfx->fillRoundRect(x, 114, 44, 30, 4, C(BTN));
    if (v >= 0) snprintf(line, sizeof(line), "%.0f", v); else strlcpy(line, "-", sizeof(line));
    putCenter(x + 22, 118, line, c, 2);
    putCenter(x + 22, 135, i == 0 ? "hoy" : i == 1 ? "mañana" : "pasado", DIM);
  }
  snprintf(line, sizeof(line), "latitud geomagnética %d\xC2\xB0", (int)lround(gm));
  put(12, 160, line, DIM);
  put(12, 174, "Mira al norte, lejos de luces. En el sur", DIM);
  put(12, 186, "de Europa solo se ven con tormentas muy", DIM);
  put(12, 198, "fuertes. Estimación aproximada.", DIM);
  put(12, 210, "LED rojo = aviso de aurora. Datos: NOAA", kp >= need ? RED : DIM);
}

