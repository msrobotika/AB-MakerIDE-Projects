void tapPhoto(int x, int y) {
  auto adj = [&](int i, int dir) {
    if (i == 0) ivSec = constrain(ivSec + dir * (ivSec >= 60 ? 10 : ivSec >= 10 ? 5 : 1), 1, 600);
    if (i == 1) ivCount = constrain(ivCount + dir * (ivCount >= 100 ? 50 : 10), 0, 990);
    if (i == 2) ivDelay = constrain(ivDelay + dir * 5, 0, 60);
  };
  for (int i = 0; i < 3; i++) {
    int bx0 = i == 1 ? 166 : 12, by0 = i == 2 ? 126 : 82;
    if (y >= by0 && y < by0 + 38 && !shooting) {
      if (x >= bx0 + 82 && x < bx0 + 110) { adj(i, -1); drawPhotoTab(); return; }
      if (x >= bx0 + 110 && x < bx0 + 140) { adj(i, 1); drawPhotoTab(); return; }
    }
  }
  if (y >= 172 && y < 202) {
    if (x < 160) {
      shooting = !shooting;
      if (shooting) { shots = 0; nextShotAt = millis() + ivDelay * 1000UL; }
      Serial.printf("MSR_ASTRO_INTERVAL %s sec=%d count=%d\n", shooting ? "START" : "STOP", ivSec, ivCount);
    } else if (shutter()) { shots++; Serial.println("MSR_ASTRO_SHOT manual"); }
    drawPhotoTab();
  }
}

