// ---------- Texto con acentos (fuente clásica CP437) ----------
uint8_t mapUtf8(const uint8_t*& p) {
  uint8_t c = *p++;
  if (c < 0x80) return c;
  if (c == 0xC3) {
    switch (*p++) {
      case 0xA1: return 0xA0; case 0xA9: return 0x82; case 0xAD: return 0xA1;
      case 0xB3: return 0xA2; case 0xBA: return 0xA3; case 0xB1: return 0xA4;
      case 0x91: return 0xA5; case 0xBC: return 0x81; case 0x89: return 0x90;
      case 0x81: return 'A'; case 0x8D: return 'I'; case 0x93: return 'O'; case 0x9A: return 'U';
      default: return '?';
    }
  }
  if (c == 0xC2) { uint8_t d = *p++; return d == 0xBF ? 0xA8 : d == 0xA1 ? 0xAD : d == 0xBA ? 0xF8 : d == 0xB7 ? 0xFA : d == 0xB0 ? 0xF8 : '?'; }
  while ((*p & 0xC0) == 0x80) p++;
  return '?';
}
int textWidth(const char* s, uint8_t size) { int n = 0; for (const uint8_t* p = (const uint8_t*)s; *p;) { mapUtf8(p); n++; } return n * 6 * size; }
void put(int x, int y, const char* s, uint16_t fg, uint8_t size = 1, int32_t bg = -1) {
  gfx->setFont();
  uint16_t f = C(fg), b = bg < 0 ? f : C((uint16_t)bg);
  for (const uint8_t* p = (const uint8_t*)s; *p; x += 6 * size) gfx->drawChar(x, y, mapUtf8(p), f, b, size);
}
void putCenter(int cxm, int y, const char* s, uint16_t fg, uint8_t size = 1, int32_t bg = -1) { put(cxm - textWidth(s, size) / 2, y, s, fg, size, bg); }
void setLed(bool r, bool g, bool b) { digitalWrite(LED_R, !r); digitalWrite(LED_G, !g); digitalWrite(LED_B, !b); }
void btn(int x, int y, int w, int h, const char* s, uint16_t fg, uint16_t bg = BTN) {
  gfx->fillRoundRect(x, y, w, h, 4, C(bg));
  putCenter(x + w / 2, y + (h - 8) / 2, s, fg, 1, bg);
}

// ---------- Tiempo ----------
int64_t daysFromCivil(int y, int m, int d) {  // algoritmo de Howard Hinnant
  y -= m <= 2;
  int64_t era = (y >= 0 ? y : y - 399) / 400;
  unsigned yoe = (unsigned)(y - era * 400), doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
  unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + (int64_t)doe - 719468;
}
time_t parseIso(const char* s) {  // "2026-11-05T18:00[:00]" -> segundos (sin zona)
  int y, mo, d, h = 0, mi = 0;
  if (sscanf(s, "%d-%d-%dT%d:%d", &y, &mo, &d, &h, &mi) < 3) return 0;
  return (time_t)(daysFromCivil(y, mo, d) * 86400 + h * 3600 + mi * 60);
}
time_t nowUtc() { return time(nullptr); }
time_t viewUtc() { return nowUtc() + shiftH * 3600; }
void fmtHM(time_t utc, char* out) { time_t l = utc + utcOffset; snprintf(out, 6, "%02d:%02d", (int)(l % 86400 / 3600), (int)(l % 3600 / 60)); }
const char* dirName(double az) { return DIRS[(int)((az + 22.5) / 45) % 8]; }

double lstAt(time_t utc) { return astro::rev(astro::gmst(astro::dayNumber(utc)) + homeLon); }
double sunAlt(time_t utc) { astro::Eq s = astro::sun(astro::dayNumber(utc)); return astro::toHorizon(s.ra, s.dec, lstAt(utc), homeLat).alt; }
double moonAlt(time_t utc) { return astro::moonHorizon(astro::dayNumber(utc), lstAt(utc), homeLat).alt; }

// Siguiente cruce de una altura (sube=true: al subir) en las próximas `hours`, pasos de 10 min.
time_t nextCross(double (*altFn)(time_t), time_t from, double level, bool rising, int hours) {
  double prev = altFn(from);
  for (time_t t = from + 600; t <= from + hours * 3600; t += 600) {
    double a = altFn(t);
    if (rising ? (prev < level && a >= level) : (prev > level && a <= level)) {
      time_t lo = t - 600, hi = t;  // afinar por bisección
      for (int i = 0; i < 8; i++) { time_t mid = (lo + hi) / 2; bool up = altFn(mid) >= level; if (up == rising) hi = mid; else lo = mid; }
      return hi;
    }
    prev = a;
  }
  return 0;
}

// ---------- Ubicación desde texto (coordenadas o enlace de Google Maps) ----------
String urlDecode(const String& s) {
  String o;
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '%' && i + 2 < s.length()) { o += (char)strtol(s.substring(i + 1, i + 3).c_str(), nullptr, 16); i += 2; }
    else o += c == '+' ? ' ' : c;
  }
  return o;
}
bool numPairAt(const char* p, float& la, float& lo) {
  char* e;
  double a = strtod(p, &e);
  if (e == p || !memchr(p, '.', e - p)) return false;
  while (*e == ' ' || *e == ',' || *e == ';') { if (*e == ',' || *e == ';') { e++; while (*e == ' ') e++; break; } e++; }
  const char* q = e;
  if (*q == '+') q++;
  double b = strtod(q, &e);
  if (e == q || !memchr(q, '.', e - q)) return false;
  if (a < -90 || a > 90 || b < -180 || b > 180 || (a == 0 && b == 0)) return false;
  la = a; lo = b;
  return true;
}
bool parseLocation(const String& raw, float& la, float& lo) {
  String s = urlDecode(raw);
  const char* c = s.c_str();
  const char* p3 = strstr(c, "!3d");  // marcador del sitio: más fiable que la vista del mapa
  if (p3) {
    const char* p4 = strstr(p3, "!4d");
    if (p4) {
      float a = atof(p3 + 3), b = atof(p4 + 3);
      if (a >= -90 && a <= 90 && b >= -180 && b <= 180 && (a || b)) { la = a; lo = b; return true; }
    }
  }
  const char* at = strchr(c, '@');
  for (const char* p = at ? at + 1 : c; *p; p++)
    if ((*p == '-' || isdigit((unsigned char)*p)) && (p == c || !isdigit((unsigned char)p[-1]) && p[-1] != '.') && numPairAt(p, la, lo)) return true;
  return false;
}

// ---------- Red ----------
bool httpsGet(const String& url, JsonDocument& doc, JsonDocument* filter) {
  WiFiClientSecure client;
  client.setCACert(ROOT_CA);
  client.setTimeout(12);
  HTTPClient http;
  http.setTimeout(12000);
  if (!http.begin(client, url)) { strlcpy(netError, "No se pudo abrir HTTPS", sizeof(netError)); return false; }
  http.useHTTP10(true);  // sin respuesta troceada (chunked), que rompe la lectura directa del JSON
  http.setUserAgent("AstroCYD-MS/1.0 (CYD; github.com/msrobotika)");
  int code = http.GET();
  if (code != 200) { snprintf(netError, sizeof(netError), "HTTP %d", code); http.end(); return false; }
  DeserializationError err = filter ? deserializeJson(doc, http.getStream(), DeserializationOption::Filter(*filter))
                                    : deserializeJson(doc, http.getStream());
  http.end();
  if (err) { snprintf(netError, sizeof(netError), "JSON %s", err.c_str()); return false; }
  netError[0] = 0;
  return true;
}

bool fetchWeather() {
  char url[200];
  snprintf(url, sizeof(url), "https://api.open-meteo.com/v1/forecast?latitude=%.3f&longitude=%.3f&hourly=cloud_cover&timezone=auto&forecast_days=2", homeLat, homeLon);
  JsonDocument filter;
  filter["utc_offset_seconds"] = true;
  filter["hourly"]["time"][0] = true;
  filter["hourly"]["cloud_cover"] = true;
  JsonDocument doc;
  if (!httpsGet(url, doc, &filter)) { Serial.printf("MSR_ASTRO_WEATHER_ERROR %s\n", netError); return false; }
  utcOffset = doc["utc_offset_seconds"] | utcOffset;
  cloudStart = parseIso(doc["hourly"]["time"][0] | "") - utcOffset;
  JsonArray cc = doc["hourly"]["cloud_cover"].as<JsonArray>();
  int n = 0;
  for (JsonVariant v : cc) { if (n >= 48) break; cloud[n++] = v.isNull() ? -1 : v.as<int>(); }
  for (; n < 48; n++) cloud[n] = -1;
  Serial.printf("MSR_ASTRO_WEATHER_OK offset=%ld hours=%d first=%d\n", (long)utcOffset, (int)cc.size(), cloud[0]);
  return cloudStart > 0;
}
int cloudAt(time_t utc) {
  if (!cloudStart) return -1;
  long i = (long)((utc - cloudStart) / 3600);
  return i >= 0 && i < 48 ? cloud[i] : -1;
}

bool fetchKp() {
  JsonDocument filter;
  filter[0]["time_tag"] = true;
  filter[0]["kp"] = true;
  JsonDocument doc;
  if (!httpsGet("https://services.swpc.noaa.gov/products/noaa-planetary-k-index-forecast.json", doc, &filter)) {
    Serial.printf("MSR_ASTRO_KP_ERROR %s\n", netError);
    return false;
  }
  JsonArray a = doc.as<JsonArray>();
  int skip = max(0, (int)a.size() - KPN), n = 0, i = 0;
  for (JsonObject o : a) {
    if (i++ < skip) continue;
    kpTime[n] = parseIso(o["time_tag"] | "");
    kpVal[n] = o["kp"] | 0.0f;
    n++;
  }
  kpN = n;
  Serial.printf("MSR_ASTRO_KP_OK n=%d\n", n);
  return n > 0;
}
float kpNow() {  // valor del intervalo de 3 h en curso
  time_t t = nowUtc();
  float v = -1;
  for (int i = 0; i < kpN; i++) if (kpTime[i] <= t) v = kpVal[i];
  return v;
}
float kpMaxDay(int dayOffset) {  // día local: 0 hoy, 1 mañana...
  time_t l0 = (nowUtc() + utcOffset) / 86400 * 86400 + dayOffset * 86400LL - utcOffset;
  float m = -1;
  for (int i = 0; i < kpN; i++) if (kpTime[i] >= l0 && kpTime[i] < l0 + 86400) m = max(m, kpVal[i]);
  return m;
}

bool ipLocate() {
  JsonDocument filter;
  filter["latitude"] = true;
  filter["longitude"] = true;
  JsonDocument doc;
  if (!httpsGet("https://ipapi.co/json/", doc, &filter) || doc["latitude"].isNull()) { Serial.printf("MSR_ASTRO_IPLOC_ERROR %s\n", netError); return false; }
  homeLat = doc["latitude"].as<float>();
  homeLon = doc["longitude"].as<float>();
  strlcpy(locSource, "internet", sizeof(locSource));
  prefs.putFloat("lat", homeLat); prefs.putFloat("lon", homeLon); prefs.putString("src", locSource);
  Serial.println("MSR_ASTRO_IPLOC_OK");
  return true;
}

// Sigue las redirecciones del enlace corto de Google Maps hasta encontrar coordenadas.
bool resolveMapsLink(String url) {
  for (int hop = 0; hop < 5; hop++) {
    float la, lo;
    if (parseLocation(url, la, lo)) {
      homeLat = la; homeLon = lo;
      strlcpy(locSource, "enlace", sizeof(locSource));
      prefs.putFloat("lat", la); prefs.putFloat("lon", lo); prefs.putString("src", locSource);
      prefs.remove("link");
      Serial.printf("MSR_ASTRO_LINK_OK hops=%d\n", hop);
      return true;
    }
    if (!url.startsWith("https://")) break;
    WiFiClientSecure client;
    client.setCACert(ROOT_CA);
    HTTPClient http;
    http.setFollowRedirects(HTTPC_DISABLE_FOLLOW_REDIRECTS);
    if (!http.begin(client, url)) break;
    const char* keys[] = {"Location"};
    http.collectHeaders(keys, 1);
    int code = http.GET();
    String next = http.header("Location");
    http.end();
    Serial.printf("MSR_ASTRO_LINK_HOP code=%d\n", code);
    if (next.isEmpty()) break;
    url = next;
  }
  Serial.println("MSR_ASTRO_LINK_FAIL");
  return false;
}

