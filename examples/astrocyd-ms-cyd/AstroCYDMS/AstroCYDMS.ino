// Cálculos astronómicos de AstroCYD MS (método de Paul Schlyter, "How to compute planetary
// positions"): Sol, Luna y planetas con error de 1-2 minutos de arco, de sobra para un mapa
// de 320x240. Ángulos en grados. d = días desde 2000 ene 0.0 TU.
// shortcut: las estrellas van en J2000 y los planetas en el equinoccio de la fecha (0,4° en 2026,
// medio píxel en el mapa); si se quiere más precisión, precesar las estrellas al arrancar.
#include <math.h>
#include <time.h>

namespace astro {

constexpr double RAD = M_PI / 180.0;
inline double rev(double x) { x = fmod(x, 360.0); return x < 0 ? x + 360 : x; }
inline double sind(double x) { return sin(x * RAD); }
inline double cosd(double x) { return cos(x * RAD); }
inline double atan2d(double y, double x) { return atan2(y, x) / RAD; }
inline double asind(double x) { return asin(fmax(-1.0, fmin(1.0, x))) / RAD; }

inline double dayNumber(time_t utc) { return utc / 86400.0 - 10956.0; }  // 2000-01-00 00:00 = 946598400 s
inline double obliquity(double d) { return 23.4393 - 3.563e-7 * d; }

struct Eq { double ra, dec, dist; };      // dist en UA (Luna: radios terrestres)
struct Hor { double alt, az; };           // az desde el norte hacia el este

inline void eclToEq(double lon, double lat, double r, double d, Eq& e) {
  double x = r * cosd(lon) * cosd(lat), y = r * sind(lon) * cosd(lat), z = r * sind(lat);
  double ecl = obliquity(d);
  double ye = y * cosd(ecl) - z * sind(ecl), ze = y * sind(ecl) + z * cosd(ecl);
  e.ra = rev(atan2d(ye, x));
  e.dec = atan2d(ze, sqrt(x * x + ye * ye));
  e.dist = r;
}

inline double eccAnomaly(double M, double e) {
  double E = M + e / RAD * sind(M) * (1 + e * cosd(M));
  for (int i = 0; i < 8; i++) {
    double dE = (E - e / RAD * sind(E) - M) / (1 - e * cosd(E));
    E -= dE;
    if (fabs(dE) < 1e-6) break;
  }
  return E;
}

// Sol: longitud eclíptica y distancia (UA). Ls = longitud media, para el tiempo sidéreo.
struct SunState { double lon, r, Ls, M; };
inline SunState sunState(double d) {
  double w = 282.9404 + 4.70935e-5 * d, e = 0.016709 - 1.151e-9 * d, M = rev(356.0470 + 0.9856002585 * d);
  double E = eccAnomaly(M, e);
  double xv = cosd(E) - e, yv = sqrt(1 - e * e) * sind(E);
  return {rev(atan2d(yv, xv) + w), sqrt(xv * xv + yv * yv), rev(w + M), M};
}
inline Eq sun(double d) { SunState s = sunState(d); Eq e; eclToEq(s.lon, 0, s.r, d, e); return e; }

// Tiempo sidéreo de Greenwich en grados.
inline double gmst(double d) { double ut = fmod(d + 10956.0, 1.0) * 24; if (ut < 0) ut += 24; return rev(sunState(d).Ls + 180 + ut * 15); }

inline Hor toHorizon(double ra, double dec, double lst, double lat) {
  double ha = lst - ra;
  double x = cosd(ha) * cosd(dec), y = sind(ha) * cosd(dec), z = sind(dec);
  double xh = x * sind(lat) - z * cosd(lat), zh = x * cosd(lat) + z * sind(lat);
  return {asind(zh), rev(atan2d(y, xh) + 180)};
}

// Luna geocéntrica con las perturbaciones principales; lon/lat eclípticas de salida.
struct MoonState { Eq eq; double lon, lat; };
inline MoonState moon(double d) {
  double N = rev(125.1228 - 0.0529538083 * d), i = 5.1454, w = rev(318.0634 + 0.1643573223 * d);
  double a = 60.2666, e = 0.054900, M = rev(115.3654 + 13.0649929509 * d);
  double E = eccAnomaly(M, e);
  double xv = a * (cosd(E) - e), yv = a * sqrt(1 - e * e) * sind(E);
  double v = atan2d(yv, xv), r = sqrt(xv * xv + yv * yv);
  double xh = r * (cosd(N) * cosd(v + w) - sind(N) * sind(v + w) * cosd(i));
  double yh = r * (sind(N) * cosd(v + w) + cosd(N) * sind(v + w) * cosd(i));
  double zh = r * sind(v + w) * sind(i);
  double lon = atan2d(yh, xh), lat = atan2d(zh, sqrt(xh * xh + yh * yh));
  SunState s = sunState(d);
  double Ms = s.M, Mm = M, Lm = rev(N + w + M), D = Lm - s.Ls, F = Lm - N;
  lon += -1.274 * sind(Mm - 2 * D) + 0.658 * sind(2 * D) - 0.186 * sind(Ms) - 0.059 * sind(2 * Mm - 2 * D)
         - 0.057 * sind(Mm - 2 * D + Ms) + 0.053 * sind(Mm + 2 * D) + 0.046 * sind(2 * D - Ms) + 0.041 * sind(Mm - Ms)
         - 0.035 * sind(D) - 0.031 * sind(Mm + Ms) - 0.015 * sind(2 * F - 2 * D) + 0.011 * sind(Mm - 4 * D);
  lat += -0.173 * sind(F - 2 * D) - 0.055 * sind(Mm - F - 2 * D) - 0.046 * sind(Mm + F - 2 * D)
         + 0.033 * sind(F + 2 * D) + 0.017 * sind(2 * Mm + F);
  r += -0.58 * cosd(Mm - 2 * D) - 0.46 * cosd(2 * D);
  MoonState m;
  m.lon = rev(lon); m.lat = lat;
  eclToEq(m.lon, lat, r, d, m.eq);
  return m;
}
// Fracción iluminada (0-1) y edad en grados (0 nueva, 90 cuarto creciente, 180 llena).
inline void moonPhase(double d, double& illum, double& age) {
  MoonState m = moon(d);
  SunState s = sunState(d);
  age = rev(m.lon - s.lon);
  double elong = acos(cosd(m.lon - s.lon) * cosd(m.lat)) / RAD;
  illum = (1 - cosd(elong)) / 2;
}
// Altura topocéntrica de la Luna (paralaje de hasta 1°).
inline Hor moonHorizon(double d, double lst, double lat) {
  MoonState m = moon(d);
  Hor h = toHorizon(m.eq.ra, m.eq.dec, lst, lat);
  h.alt -= asind(1 / m.eq.dist) * cosd(h.alt);
  return h;
}

// Planetas: 0 Mercurio, 1 Venus, 2 Marte, 3 Júpiter, 4 Saturno.
struct Planet { Eq eq; double mag; };
inline Planet planet(int p, double d) {
  static const double EL[5][12] = {
    // N, dN, i, di, w, dw, a, e, de, M, dM, (sin uso)
    {48.3313, 3.24587e-5, 7.0047, 5.00e-8, 29.1241, 1.01444e-5, 0.387098, 0.205635, 5.59e-10, 168.6562, 4.0923344368, 0},
    {76.6799, 2.46590e-5, 3.3946, 2.75e-8, 54.8910, 1.38374e-5, 0.723330, 0.006773, -1.302e-9, 48.0052, 1.6021302244, 0},
    {49.5574, 2.11081e-5, 1.8497, -1.78e-8, 286.5016, 2.92961e-5, 1.523688, 0.093405, 2.516e-9, 18.6021, 0.5240207766, 0},
    {100.4542, 2.76854e-5, 1.3030, -1.557e-7, 273.8777, 1.64505e-5, 5.20256, 0.048498, 4.469e-9, 19.8950, 0.0830853001, 0},
    {113.6634, 2.38980e-5, 2.4886, -1.081e-7, 339.3939, 2.97661e-5, 9.55475, 0.055546, -9.499e-9, 316.9670, 0.0334442282, 0}};
  const double* k = EL[p];
  double N = k[0] + k[1] * d, i = k[2] + k[3] * d, w = k[4] + k[5] * d, a = k[6], e = k[7] + k[8] * d, M = rev(k[9] + k[10] * d);
  double E = eccAnomaly(M, e);
  double xv = a * (cosd(E) - e), yv = a * sqrt(1 - e * e) * sind(E);
  double v = atan2d(yv, xv), r = sqrt(xv * xv + yv * yv);
  double xh = r * (cosd(N) * cosd(v + w) - sind(N) * sind(v + w) * cosd(i));
  double yh = r * (sind(N) * cosd(v + w) + cosd(N) * sind(v + w) * cosd(i));
  double zh = r * sind(v + w) * sind(i);
  double lon = atan2d(yh, xh), lat = atan2d(zh, sqrt(xh * xh + yh * yh));
  if (p >= 3) {  // perturbaciones mutuas de Júpiter y Saturno
    double Mj = rev(19.8950 + 0.0830853001 * d), Ms = rev(316.9670 + 0.0334442282 * d);
    if (p == 3)
      lon += -0.332 * sind(2 * Mj - 5 * Ms - 67.6) - 0.056 * sind(2 * Mj - 2 * Ms + 21) + 0.042 * sind(3 * Mj - 5 * Ms + 21)
             - 0.036 * sind(Mj - 2 * Ms) + 0.022 * cosd(Mj - Ms) + 0.023 * sind(2 * Mj - 3 * Ms + 52) - 0.016 * sind(Mj - 5 * Ms - 69);
    else {
      lon += 0.812 * sind(2 * Mj - 5 * Ms - 67.6) - 0.229 * cosd(2 * Mj - 4 * Ms - 2) + 0.119 * sind(Mj - 2 * Ms - 3)
             + 0.046 * sind(2 * Mj - 6 * Ms - 69) + 0.014 * sind(Mj - 3 * Ms + 32);
      lat += -0.020 * cosd(2 * Mj - 4 * Ms - 2) + 0.018 * sind(2 * Mj - 6 * Ms - 49);
    }
  }
  xh = r * cosd(lon) * cosd(lat); yh = r * sind(lon) * cosd(lat); zh = r * sind(lat);
  SunState s = sunState(d);
  double xg = xh + s.r * cosd(s.lon), yg = yh + s.r * sind(s.lon), zg = zh;
  double R = sqrt(xg * xg + yg * yg + zg * zg);
  Planet out;
  eclToEq(atan2d(yg, xg), atan2d(zg, sqrt(xg * xg + yg * yg)), R, d, out.eq);
  double FV = acos(fmax(-1.0, fmin(1.0, (r * r + R * R - s.r * s.r) / (2 * r * R)))) / RAD;
  static const double M0[5] = {-0.36, -4.34, -1.51, -9.25, -9.0}, K1[5] = {0.027, 0.013, 0.016, 0.014, 0.044};
  out.mag = M0[p] + 5 * log10(r * R) + K1[p] * FV;
  if (p == 0) out.mag += 2.2e-13 * pow(FV, 6);
  if (p == 1) out.mag += 4.2e-7 * FV * FV * FV;
  return out;
}

// Polo norte geomagnético (modelo IGRF de dipolo, época 2025, aprox.).
inline double geomagLat(double lat, double lon) {
  const double PLAT = 80.8, PLON = -72.6;
  return asind(sind(lat) * sind(PLAT) + cosd(lat) * cosd(PLAT) * cosd(lon - PLON));
}
// Kp aproximado para ver auroras sobre el horizonte norte en esa latitud geomagnética.
// Ajuste empírico: Kp 9 llega a ~43° (mayo 2024 en España), Kp 5 a ~53°.
inline double kpNeeded(double gmLat) { return (66.5 - gmLat) / 2.6; }

// Magnitud límite a simple vista por clase de Bortle (1 a 9).
inline float limitingMag(int bortle) {
  static const float L[10] = {6.0f, 7.6f, 7.1f, 6.6f, 6.1f, 5.6f, 5.1f, 4.6f, 4.1f, 3.8f};
  return L[bortle < 1 ? 1 : bortle > 9 ? 9 : bortle];
}

