bool redMode = false;
uint16_t C(uint16_t c) {
  if (!redMode) return c;
  int r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
  int l = (r * 2 * 77 + g * 150 + b * 2 * 29) >> 9;  // luminancia 0-31 aprox.
  return (uint16_t)(min(31, l + (l > 0 ? 2 : 0)) << 11);
}

